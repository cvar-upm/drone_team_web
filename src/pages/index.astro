---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import AssetImage from '../components/AssetImage.astro';
import LiteVimeo from '../components/LiteVimeo.astro';
import Terminal from '../components/Terminal.astro';
import Icon from '../components/Icon.astro';
import { divisions } from '../data/divisions';
import { applyForm } from '../data/social';
import { url } from '../lib/url';

const aerostack2 = divisions.find((d) => d.id === 'aerostack2')!;

// Flight path drawn behind the hero (viewBox 0 0 1200 600) and the waypoints on it
// Drawn in the empty band above the photos (right column, desktop only) so it never crosses the text
const flightPath = 'M -10 70 C 100 30, 200 105, 300 95 C 400 85, 460 35, 560 42 C 660 50, 720 100, 830 85';
const waypoints = [
  { x: 300, y: 95, delay: '1.4s' },
  { x: 560, y: 42, delay: '2s' },
];
---
<Layout title="CVAR-UPM Drone Team" header={false}>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-base-100">
    <!-- Background: dot grid, soft glow and an animated flight path -->
    <div class="bg-dot-grid absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="absolute -top-40 right-0 -z-10 h-[32rem] w-[32rem] rounded-full bg-secondary/15 blur-3xl" aria-hidden="true"></div>
    <svg class="absolute top-0 right-0 -z-10 hidden h-auto w-[60%] text-primary lg:block" viewBox="0 0 800 140" aria-hidden="true">
      <defs>
        <mask id="flight-mask">
          <path d={flightPath} pathLength="1" fill="none" stroke="white" stroke-width="8" class="animate-draw" />
        </mask>
      </defs>
      <path id="flight-path" d={flightPath} fill="none" stroke="currentColor" stroke-opacity="0.35" stroke-width="2" stroke-dasharray="6 10" stroke-linecap="round" mask="url(#flight-mask)" />
      {waypoints.map((point) => (
        <g class="motion-safe:animate-fade-in" style={`animation-delay: ${point.delay}`}>
          <circle cx={point.x} cy={point.y} r="10" fill="currentColor" fill-opacity="0.08" />
          <circle cx={point.x} cy={point.y} r="4" fill="currentColor" fill-opacity="0.5" />
        </g>
      ))}
      <g class="flight-marker" opacity="0">
        <set attributeName="opacity" to="0.7" begin="2.8s" fill="freeze" />
        <animateMotion dur="12s" begin="2.8s" repeatCount="indefinite" rotate="auto">
          <mpath href="#flight-path" />
        </animateMotion>
        <g fill="none" stroke="currentColor" stroke-width="2">
          <path d="M -9 -9 L 9 9 M -9 9 L 9 -9" />
          <circle cx="-9" cy="-9" r="5" />
          <circle cx="9" cy="9" r="5" />
          <circle cx="-9" cy="9" r="5" />
          <circle cx="9" cy="-9" r="5" />
        </g>
        <rect x="-3" y="-3" width="6" height="6" rx="1" fill="currentColor" />
      </g>
    </svg>

    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 py-10 md:py-20 lg:grid-cols-[5fr_7fr] lg:gap-12">
      <div>
        <p class="mb-4 text-sm font-semibold tracking-widest text-secondary uppercase motion-safe:animate-fade-up">CVAR-UPM Drone Team</p>
        <h1 class="text-4xl font-bold tracking-tight text-balance sm:text-5xl lg:text-6xl motion-safe:animate-fade-up motion-safe:[animation-delay:100ms]">
          Research in autonomous aerial robotics
        </h1>
        <p class="mt-5 max-w-xl text-base text-base-content/70 md:mt-6 md:text-lg motion-safe:animate-fade-up motion-safe:[animation-delay:200ms]">
          We are part of the Computer Vision and Aerial Robotics Group at UPM-CSIC, developing perception, state estimation,
          planning and control for autonomous drones, and putting them to the test in research projects and international competitions.
        </p>
        <div class="mt-8 flex flex-col gap-4 sm:mt-10 sm:flex-row sm:items-center sm:gap-6 motion-safe:animate-fade-up motion-safe:[animation-delay:300ms]">
          <a href={url('/contact')} class="group btn btn-primary btn-xl w-full px-12 shadow-lg shadow-primary/25 transition hover:-translate-y-0.5 hover:shadow-xl hover:shadow-primary/30 sm:w-auto">
            Join us
            <span class="transition group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
          </a>
          <a href={url('/divisions')} class="group self-center text-lg font-semibold text-primary sm:self-auto">
            Our research <span class="inline-block transition group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Photo collage -->
      <div class="relative px-3 py-8 sm:px-8 sm:py-12">
        <div class="motion-safe:animate-fade-in motion-safe:[animation-delay:150ms]">
          <AssetImage
            src="/members/team.jpeg"
            alt="The CVAR-UPM Drone Team"
            loading="eager"
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 1280px) 42rem, (min-width: 1024px) 52vw, 100vw"
            class="h-auto w-full rounded-box object-contain shadow-xl"
          />
        </div>
        <div class="absolute top-0 right-0 w-[36%] motion-safe:animate-fade-up motion-safe:[animation-delay:450ms]">
          <div class="parallax-up">
            <AssetImage src="/imav_dron.jpeg" alt="Drone carrying a payload during an indoor mission" loading="eager" widths={[320, 640]} sizes="(min-width: 1024px) 16rem, 36vw" class="aspect-4/3 w-full rounded-box object-cover shadow-xl ring-4 ring-base-100" />
          </div>
        </div>
        <div class="absolute bottom-0 left-0 w-[32%] motion-safe:animate-fade-up motion-safe:[animation-delay:650ms]">
          <div class="parallax-down">
            <AssetImage src="/imav19/imav19_8.jpg" alt="Autonomous indoor flight with visual markers" loading="eager" widths={[320, 640]} sizes="(min-width: 1024px) 14rem, 32vw" class="aspect-4/3 w-full rounded-box object-cover shadow-xl ring-4 ring-base-100" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Who we are -->
  <Section tone="muted">
    <div class="grid gap-8 lg:grid-cols-[1fr_2fr] lg:gap-16">
      <div class="reveal">
        <p class="mb-3 text-sm font-semibold tracking-widest text-secondary uppercase">About</p>
        <h2 class="text-3xl font-bold tracking-tight md:text-4xl">Who we are</h2>
      </div>
      <div class="reveal space-y-5 text-base leading-relaxed text-base-content/80 md:text-lg" style="--stagger: 1">
        <p>
          We are a passionate team of drone enthusiasts from the Computer Vision and Aerial Robotics Group. We are united by our
          commitment to technology, innovation, and high-performance flight. Our mission is to push the boundaries of autonomous drone
          systems by combining advanced perception, state estimation, aerodynamics, and cutting-edge electronics in order to compete at
          the highest level.
        </p>
        <p>
          At the core of our project are collaboration, continuous learning, and community. We bring together engineers, pilots,
          programmers, and designers to share knowledge, solve complex problems, and inspire the next generation of autonomous aerial
          robotics professionals. Whether you are an experienced drone professional or are new to the field, we strive to create an
          environment where everyone can learn, grow, and contribute meaningfully.
        </p>
        <p>
          Driven by curiosity and powered by teamwork, we design, build, and race competition-level drones that demonstrate our
          technical expertise and passion for innovation. Welcome to our world, where autonomy meets speed.
        </p>
      </div>
    </div>
  </Section>

  <!-- Research areas -->
  <Section eyebrow="Research" title="Research areas" intro="Our work spans the full autonomy stack, from hardware to multi-drone coordination.">
    <div class="grid gap-3 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4">
      {divisions.map((division, i) => (
        <div class="reveal" style={`--stagger: ${i % 4}`}>
          <a
            href={url(`/divisions#${division.id}`)}
            class="group flex h-full overflow-hidden rounded-box border border-base-300 bg-base-100 transition duration-300 hover:-translate-y-1 hover:border-primary/50 hover:shadow-xl hover:shadow-primary/10 sm:flex-col"
          >
            <div class="aspect-square w-24 shrink-0 overflow-hidden bg-base-200 sm:aspect-video sm:w-auto">
              <AssetImage src={division.image} alt="" widths={[320, 640]} sizes="(min-width: 1024px) 16rem, (min-width: 640px) 45vw, 100vw" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
            </div>
            <div class="flex flex-1 flex-col justify-center gap-1 p-4 sm:justify-start sm:gap-2 sm:p-5">
              <h3 class="font-semibold leading-snug transition group-hover:text-primary">{division.title}</h3>
              <p class="text-sm text-base-content/70">{division.summary}</p>
              <span class="mt-auto hidden pt-2 text-sm font-medium text-primary sm:block">
                Learn more <span class="inline-block transition group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
              </span>
            </div>
          </a>
        </div>
      ))}
    </div>
  </Section>

  <!-- Aerostack2 -->
  <Section tone="tint">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="reveal">
        <p class="mb-3 text-sm font-semibold tracking-widest text-secondary uppercase">Open source</p>
        <h2 class="text-3xl font-bold tracking-tight md:text-4xl">Powered by Aerostack2</h2>
        <p class="mt-5 text-base leading-relaxed text-base-content/80 md:text-lg [&_a]:link [&_a]:link-primary" set:html={aerostack2.description[0]} />
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="https://github.com/aerostack2/aerostack2" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            <Icon name="github" class="h-4 w-4" /> GitHub
          </a>
          <a href="https://aerostack2.github.io/" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-primary">Documentation</a>
          <img src="https://img.shields.io/github/stars/aerostack2/aerostack2?style=social" alt="Aerostack2 GitHub stars" loading="lazy" class="h-5" />
        </div>
      </div>
      <div class="reveal" style="--stagger: 1">
        <Terminal
          title="aerostack2"
          lines={[
            { text: 'sudo apt install ros-humble-aerostack2', command: true },
            { text: 'source /opt/ros/humble/setup.bash', command: true },
            { text: 'ros2 pkg list | grep as2_core', command: true },
            { text: 'as2_core' },
          ]}
        />
      </div>
    </div>
  </Section>

  <!-- Video -->
  <Section eyebrow="In action" title="See our work">
    <div class="reveal mx-auto max-w-5xl">
      <LiteVimeo id="1155503452" hash="511c5f0706" title="CVAR-UPM Drone Team" fallbackPoster="/a2rl26/a2rl.jpeg" />
    </div>
  </Section>

  <!-- Join -->
  <section class="px-4 pb-12 md:pb-24">
    <div class="reveal relative isolate mx-auto flex max-w-6xl flex-col items-start gap-6 overflow-hidden rounded-box bg-primary px-6 py-10 text-primary-content md:flex-row md:items-center md:justify-between md:px-12 md:py-14">
      <div class="bg-line-grid animate-grid-drift absolute inset-0 -z-10" aria-hidden="true"></div>
      <div class="absolute -top-24 -right-16 -z-10 h-72 w-72 rounded-full bg-secondary/60 blur-3xl" aria-hidden="true"></div>
      <div class="max-w-xl">
        <h2 class="text-3xl font-bold tracking-tight md:text-4xl">Join the team</h2>
        <p class="mt-3 text-primary-content/85">
          We are always looking for motivated students and researchers who want to learn, build and fly autonomous drones with us.
        </p>
      </div>
      <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <a href={applyForm} target="_blank" rel="noopener noreferrer" class="btn btn-lg border-0 bg-white text-primary shadow-lg transition hover:-translate-y-0.5 hover:bg-white">Apply now</a>
        <a href={url('/contact')} class="btn btn-lg btn-ghost border-white/40 text-primary-content hover:bg-white/10">Contact us</a>
      </div>
    </div>
  </section>
</Layout>
