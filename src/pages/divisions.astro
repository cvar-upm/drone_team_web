---
import Layout from '../layouts/Layout.astro';
import AssetImage from '../components/AssetImage.astro';
import { divisions } from '../data/divisions';
---
<Layout
  title="Divisions"
  intro="The research areas the team works on, from our open-source framework to perception, control, hardware and multi-drone systems."
  description="The CVAR-UPM Drone Team divisions: Aerostack2, planning and navigation, control, localization, perception, hardware, simulation and swarming."
>
  <nav aria-label="Divisions" class="sticky top-16 z-40 border-b border-base-300 bg-base-100/95 backdrop-blur md:top-20 lg:hidden">
    <ul class="mx-auto flex max-w-page gap-2 overflow-x-auto px-4 py-3 text-sm whitespace-nowrap">
      {divisions.map((division) => (
        <li>
          <a href={`#${division.id}`} class="btn btn-sm rounded-full border-base-300 bg-base-100 font-normal">{division.title}</a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="mx-auto grid max-w-page gap-12 px-4 py-10 md:py-20 lg:grid-cols-[15rem_1fr]">
    <aside class="hidden lg:block">
      <nav aria-label="Divisions" class="sticky top-24">
        <p class="mb-3 text-sm font-semibold tracking-widest text-secondary uppercase">On this page</p>
        <ul class="flex flex-col gap-1 border-l border-base-300 text-sm">
          {divisions.map((division) => (
            <li>
              <a
                href={`#${division.id}`}
                data-division-link={division.id}
                class="-ml-px block border-l-2 border-transparent py-1.5 pl-4 text-base-content/70 hover:text-primary data-active:border-primary data-active:font-medium data-active:text-primary"
              >
                {division.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>

    <div class="flex flex-col divide-y divide-base-300">
      {divisions.map((division) => (
        <section id={division.id} class="grid scroll-mt-36 gap-5 py-10 first:pt-0 last:pb-0 md:scroll-mt-40 md:grid-cols-[18rem_1fr] md:gap-10 md:py-12 lg:scroll-mt-28">
          <div class="aspect-video overflow-hidden rounded-box bg-base-200 md:sticky md:top-24 md:aspect-square md:self-start">
            <AssetImage src={division.image} alt={division.title} widths={[400, 800]} sizes="(min-width: 768px) 18rem, 100vw" class="h-full w-full object-contain" />
          </div>
          <div>
            <h2 class="text-2xl font-bold tracking-tight md:text-3xl">{division.title}</h2>
            <div class="mt-3 space-y-4 leading-relaxed text-base-content/80 md:mt-4 md:text-lg [&_a]:link [&_a]:link-primary">
              {division.description.map((paragraph) => <p set:html={paragraph} />)}
            </div>
          </div>
        </section>
      ))}
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    // Highlight the division currently in view in the side menu.
    const links = new Map(
      [...document.querySelectorAll<HTMLElement>('[data-division-link]')].map((link) => [link.dataset.divisionLink, link]),
    );
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          links.forEach((link) => link.removeAttribute('data-active'));
          links.get(entry.target.id)?.setAttribute('data-active', '');
        });
      },
      { rootMargin: '-30% 0px -60% 0px' },
    );
    links.forEach((_, id) => {
      const section = id ? document.getElementById(id) : null;
      if (section) observer.observe(section);
    });
  });
</script>
