---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import PageHeader, { type Crumb } from '../components/PageHeader.astro';
import { url } from '../lib/url';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** One sentence shown under the page title */
  intro?: string;
  /** Defaults to Home / title */
  breadcrumbs?: Crumb[];
  /** Set to false on pages that render their own hero (Home) */
  header?: boolean;
}

const {
  title,
  description = 'CVAR-UPM Drone Team: research in autonomous aerial robotics at the Computer Vision and Aerial Robotics Group, Universidad Politécnica de Madrid (UPM-CSIC).',
  intro,
  breadcrumbs = [{ label: 'Home', href: '/' }, { label: title }],
  header = true,
} = Astro.props;

const siteName = 'CVAR-UPM Drone Team';
const pageTitle = title.toUpperCase() === siteName.toUpperCase() ? siteName : `${title} | ${siteName}`;
---
<html lang="en" data-theme="cvar">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={url('/logo-cvar.png')} />
    <Font cssVariable="--font-inter" preload />
  </head>
  <body class="bg-base-100 text-base-content antialiased">
    <div class="drawer">
      <input id="nav-drawer" type="checkbox" class="drawer-toggle" />

      <div class="drawer-content flex min-h-screen flex-col">
        <Header />
        <main class="flex-1">
          {header && <PageHeader title={title} intro={intro} breadcrumbs={breadcrumbs} />}
          <slot />
        </main>
        <Footer />
      </div>

      <div class="drawer-side z-60">
        <label for="nav-drawer" aria-label="Close menu" class="drawer-overlay"></label>
        <Navigation variant="mobile" />
      </div>
    </div>

    <script>
      // Close the mobile drawer after following a link (same-page #anchors don't reload the page).
      const toggle = document.getElementById('nav-drawer') as HTMLInputElement | null;
      document.querySelectorAll('.drawer-side a').forEach((link) =>
        link.addEventListener('click', () => {
          if (toggle) toggle.checked = false;
        }),
      );
    </script>
  </body>
</html>
