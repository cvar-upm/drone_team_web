---
// Page section with consistent spacing, background and heading style.
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  intro?: string;
  /** base = white, muted = light grey, tint = light blue */
  tone?: 'base' | 'muted' | 'tint';
  /** text = reading width, wide = full content width */
  width?: 'text' | 'wide';
  class?: string;
}

const { id, eyebrow, title, intro, tone = 'base', width = 'wide', class: className } = Astro.props;
const tones = { base: 'bg-base-100', muted: 'bg-base-200', tint: 'bg-primary/5' };
---
<section id={id} class:list={[tones[tone], 'py-12 md:py-20 lg:py-24', className]}>
  <div class:list={['mx-auto px-4', width === 'text' ? 'max-w-3xl' : 'max-w-6xl']}>
    {(eyebrow || title || intro) && (
      <div class="reveal mb-8 max-w-2xl md:mb-12">
        {eyebrow && <p class="mb-3 text-sm font-semibold tracking-widest text-secondary uppercase">{eyebrow}</p>}
        {title && <h2 class="text-3xl font-bold tracking-tight text-balance md:text-4xl">{title}</h2>}
        {intro && <p class="mt-3 text-base text-base-content/70 md:mt-4 md:text-lg">{intro}</p>}
      </div>
    )}
    <slot />
  </div>
</section>
