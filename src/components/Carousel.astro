---
import AssetImage from './AssetImage.astro';
import { url } from '../lib/url';
import { isEmbedUrl, videoType } from '../lib/video';

interface Props {
  items: { type: 'image' | 'video'; src: string; alt?: string; title?: string }[];
}

const { items } = Astro.props;
---
<div class="carousel-container not-prose mx-auto my-10 max-w-5xl px-4">
  <div class="relative aspect-video overflow-hidden rounded-box bg-black shadow-lg">
    {items.map((item, index) => (
      <div
        class="carousel-item absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-500 data-active:z-10 data-active:opacity-100"
        data-active={index === 0 ? '' : undefined}
        aria-hidden={index === 0 ? undefined : 'true'}
      >
        {item.type === 'image' ? (
          <AssetImage
            src={item.src}
            alt={item.alt ?? ''}
            widths={[640, 1024, 1600]}
            sizes="(min-width: 1024px) 64rem, 100vw"
            loading={index === 0 ? 'eager' : 'lazy'}
            class="h-full w-full object-contain"
          />
        ) : isEmbedUrl(item.src) ? (
          <iframe src={item.src} title={item.title ?? `Video ${index + 1}`} class="h-full w-full border-0" allow="autoplay; fullscreen; picture-in-picture; clipboard-write" loading="lazy"></iframe>
        ) : (
          <video controls preload="metadata" class="h-full w-full object-contain">
            <source src={url(item.src)} type={videoType(item.src)} />
            Your browser does not support the video element.
          </video>
        )}
      </div>
    ))}

    {items.length > 1 && (
      <>
        <button class="carousel-prev btn btn-circle absolute top-1/2 left-3 z-20 -translate-y-1/2 border-0 bg-white/90 text-primary shadow hover:bg-white" aria-label="Previous slide">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6" /></svg>
        </button>
        <button class="carousel-next btn btn-circle absolute top-1/2 right-3 z-20 -translate-y-1/2 border-0 bg-white/90 text-primary shadow hover:bg-white" aria-label="Next slide">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6" /></svg>
        </button>
      </>
    )}
  </div>

  {items.length > 1 && (
    <div class="mt-4 flex justify-center gap-2">
      {items.map((item, index) => (
        <button
          class="carousel-dot h-3 w-3 rounded-full border-2 border-primary transition data-active:scale-125 data-active:bg-primary"
          data-active={index === 0 ? '' : undefined}
          aria-label={`Go to ${item.type} ${index + 1}`}
        ></button>
      ))}
    </div>
  )}
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('.carousel-container').forEach((container) => {
      const slides = container.querySelectorAll<HTMLElement>('.carousel-item');
      const dots = container.querySelectorAll<HTMLElement>('.carousel-dot');
      let current = 0;

      function show(index: number) {
        // Stop whatever was playing before switching slides
        container.querySelectorAll('iframe').forEach((frame) => frame.contentWindow?.postMessage('{"method":"pause"}', '*'));
        container.querySelectorAll('video').forEach((video) => video.pause());

        slides.forEach((slide, i) => {
          slide.toggleAttribute('data-active', i === index);
          slide.setAttribute('aria-hidden', String(i !== index));
        });
        dots.forEach((dot, i) => dot.toggleAttribute('data-active', i === index));
        current = index;
      }

      container.querySelector('.carousel-prev')?.addEventListener('click', () => show((current - 1 + slides.length) % slides.length));
      container.querySelector('.carousel-next')?.addEventListener('click', () => show((current + 1) % slides.length));
      dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));
    });
  });
</script>
