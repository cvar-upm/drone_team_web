---
import { navigation, joinLink } from '../data/navigation';
import { url } from '../lib/url';

const current = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => {
  const target = url(href).replace(/\/$/, '');
  return href === '/' ? current === target : current === target || current.startsWith(`${target}/`);
};
const linkClass = (href: string) => [
  'btn btn-ghost text-base font-medium',
  isActive(href) ? 'text-primary' : 'text-base-content/75 hover:text-primary',
];
---

<nav aria-label="Main" class="flex items-center gap-1">
  {navigation.map((item) =>
    item.children ? (
      <div class="dropdown dropdown-hover dropdown-end">
        <a href={url(item.href)} class:list={linkClass(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
          </svg>
        </a>
        <ul class="dropdown-content menu z-50 w-72 rounded-box border border-base-300 bg-base-100 p-2 shadow-md">
          {item.children.map((child) => (
            <li>
              <a href={url(child.href)} class:list={[child.children && 'font-semibold']}>{child.label}</a>
              {child.children && (
                <ul>
                  {child.children.map((leaf) => (
                    <li><a href={url(leaf.href)} class="text-base-content/70">{leaf.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </div>
    ) : (
      <a href={url(item.href)} class:list={linkClass(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
    )
  )}
  <a href={url(joinLink.href)} class="btn btn-primary btn-lg ml-3 px-8 shadow-sm">{joinLink.label}</a>
</nav>
