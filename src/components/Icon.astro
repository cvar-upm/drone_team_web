---
import { icons, type IconName } from '../data/icons';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'h-5 w-5' } = Astro.props;
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true" focusable="false">
  <path d={icons[name]} />
</svg>
