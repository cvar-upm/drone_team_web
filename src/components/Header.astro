---
import AssetImage from './AssetImage.astro';
import Navigation from './Navigation.astro';
import { url } from '../lib/url';
---
<header class="sticky top-0 z-50 border-b border-base-300 bg-base-100/90 backdrop-blur">
  <div class="navbar mx-auto min-h-20 max-w-7xl px-4 py-3">
    <div class="navbar-start w-auto shrink-0">
      <a href={url('/')} class="flex items-center gap-3">
        <AssetImage src="/logo-cvar.png" alt="CVAR-UPM Drone Team logo" widths={[96, 192]} sizes="56px" loading="eager" class="h-11 w-auto md:h-14" />
        <span class="flex flex-col leading-tight"><span class="text-lg font-bold tracking-tight text-base-content md:text-xl">CVAR-UPM Drone Team</span><span class="hidden text-sm text-base-content/60 sm:block lg:hidden xl:block">Computer Vision &amp; Aerial Robotics · UPM-CSIC</span></span>
      </a>
    </div>

    <div class="navbar-end flex-1">
      <div class="hidden lg:flex">
        <Navigation variant="desktop" />
      </div>
      <label for="nav-drawer" class="btn btn-ghost btn-square btn-lg lg:hidden" aria-label="Open menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </label>
    </div>
  </div>
</header>
