---
// Scattered photo collage. Every few seconds the oldest photo fades out and another project photo
// appears at a different free spot, so the collage keeps rearranging itself.
// Without JS (or with "reduce motion") it stays as a static collage of the first photos.
import AssetImage from './AssetImage.astro';

interface Photo {
  src: string;
  alt: string;
  /** Panoramic photo: only placed in the wide spots */
  wide?: boolean;
}

interface Props {
  photos: Photo[];
  /** Milliseconds between changes */
  interval?: number;
  class?: string;
}

const { photos, interval = 3200, class: className } = Astro.props;

// Spots as % of the container (which is 4:3). Wide spots are 2:1, the rest 4:3.
const spots = [
  { top: 2, left: 0, width: 60, wide: true },
  { top: 0, left: 63, width: 37, wide: false },
  { top: 30, left: 34, width: 40, wide: false },
  { top: 56, left: 2, width: 36, wide: false },
  { top: 62, left: 44, width: 56, wide: true },
  { top: 38, left: 70, width: 30, wide: false },
];

// Start with the first wide photo and the first three standard photos on spots 0-3
const firstWide = photos.findIndex((p) => p.wide);
const standard = photos.map((p, i) => (p.wide ? -1 : i)).filter((i) => i >= 0);
const initial = new Map<number, number>([
  [firstWide, 0],
  [standard[0], 1],
  [standard[1], 2],
  [standard[2], 3],
]);

const spotStyle = (spot: (typeof spots)[number]) =>
  `top:${spot.top}%;left:${spot.left}%;width:${spot.width}%;aspect-ratio:${spot.wide ? '2 / 1' : '4 / 3'}`;
---
<div
  class:list={['photo-scatter relative aspect-4/3 w-full', className]}
  data-interval={interval}
  data-spots={JSON.stringify(spots)}
>
  {photos.map((photo, i) => {
    const spot = initial.get(i);
    return (
      <div
        class="absolute overflow-hidden rounded-box bg-base-200 opacity-0 shadow-xl ring-4 ring-base-100 transition-[opacity,scale,translate] duration-1000 ease-out scale-90 translate-y-3 data-visible:scale-100 data-visible:translate-y-0 data-visible:opacity-100"
        style={spot === undefined ? undefined : `${spotStyle(spots[spot])};z-index:${spot + 1}`}
        data-photo
        data-wide={photo.wide ? '' : undefined}
        data-spot={spot}
        data-visible={spot === undefined ? undefined : ''}
        aria-hidden={spot === undefined ? 'true' : undefined}
      >
        <AssetImage
          src={photo.src}
          alt={photo.alt}
          widths={photo.wide ? [480, 800, 1200] : [320, 640]}
          sizes={photo.wide ? '(min-width: 1024px) 26rem, 60vw' : '(min-width: 1024px) 18rem, 45vw'}
          loading={spot === undefined ? 'lazy' : 'eager'}
          class="h-full w-full object-cover object-[center_35%]"
        />
      </div>
    );
  })}
</div>

<script>
  type Spot = { top: number; left: number; width: number; wide: boolean };
  let timers: number[] = [];

  document.addEventListener('astro:page-load', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    document.querySelectorAll<HTMLElement>('.photo-scatter').forEach((container) => {
      const spots: Spot[] = JSON.parse(container.dataset.spots!);
      const photos = [...container.querySelectorAll<HTMLElement>('[data-photo]')];
      const interval = Number(container.dataset.interval) || 3200;
      let z = spots.length + 1;

      // Load the hidden photos now so they are ready when their turn comes
      container.querySelectorAll('img').forEach((img) => (img.loading = 'eager'));

      // Photos currently shown, oldest first
      const shown = photos.filter((p) => p.hasAttribute('data-visible'));
      shown.sort((a, b) => Number(a.dataset.spot) - Number(b.dataset.spot));
      // Hidden photos waiting for their turn, in order
      const queue = photos.filter((p) => !p.hasAttribute('data-visible'));

      const tick = () => {
        if (document.hidden) return;

        // 1. Pick a free spot (never the one the oldest photo is about to leave)
        const taken = new Set(shown.map((p) => Number(p.dataset.spot)));
        const free = spots.map((_, i) => i).filter((i) => !taken.has(i));
        if (!free.length) return;
        const spotIndex = free[Math.floor(Math.random() * free.length)];
        const spot = spots[spotIndex];

        // 2. Find the next loaded photo with the right shape for that spot
        const nextIndex = queue.findIndex(
          (p) => p.hasAttribute('data-wide') === spot.wide && p.querySelector('img')?.complete,
        );
        if (nextIndex === -1) return; // nothing ready yet: try again next tick
        const [arriving] = queue.splice(nextIndex, 1);

        // 3. Fade out the oldest photo where it is
        const leaving = shown.shift()!;
        leaving.removeAttribute('data-visible');
        leaving.setAttribute('aria-hidden', 'true');
        delete leaving.dataset.spot;
        queue.push(leaving);
        arriving.style.cssText = `top:${spot.top}%;left:${spot.left}%;width:${spot.width}%;aspect-ratio:${spot.wide ? '2 / 1' : '4 / 3'};z-index:${z++}`;
        arriving.dataset.spot = String(spotIndex);
        arriving.removeAttribute('aria-hidden');
        // Next frame, so the browser applies the new position before fading in
        requestAnimationFrame(() => requestAnimationFrame(() => arriving.setAttribute('data-visible', '')));
        shown.push(arriving);
      };

      timers.push(window.setInterval(tick, interval));
    });
  });

  // Stop when navigating to another page
  document.addEventListener('astro:before-swap', () => {
    timers.forEach((id) => window.clearInterval(id));
    timers = [];
  });
</script>
