---
import AssetImage from './AssetImage.astro';
import Icon from './Icon.astro';
import { socialLinks, mapLink, mapEmbed } from '../data/social';
import { url } from '../lib/url';
---
<footer class="mt-16 bg-primary text-primary-content">
  <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 py-12 text-center md:grid-cols-3 md:text-left">
    <div class="flex flex-col items-center gap-4 md:items-start">
      <p class="text-lg font-medium">Do you have any questions?</p>
      <a href={url('/contact')} class="btn btn-accent">Contact us</a>
    </div>

    <div class="flex flex-col items-center gap-3">
      <AssetImage src="/logo-cvar.png" alt="" widths={[128, 256]} sizes="80px" class="h-16 w-auto md:h-20" />
      <p class="text-xl font-bold tracking-wide">CVAR DRONE TEAM</p>
    </div>

    <nav aria-label="Social media" class="flex flex-wrap justify-center gap-2 md:justify-end">
      {socialLinks.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label} class="btn btn-circle btn-ghost text-primary-content hover:bg-white/15">
          <Icon name={link.icon} />
        </a>
      ))}
    </nav>
  </div>

  <a href={mapLink} target="_blank" rel="noopener noreferrer" class="block">
    <iframe
      src={mapEmbed}
      title="CVAR Drone Team location"
      class="block h-64 w-full border-0 md:h-72"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
  </a>

  <div class="border-t border-white/20 py-6 text-center text-sm text-primary-content/80">
    <p>&copy; {new Date().getFullYear()} CVAR DRONE TEAM. All rights reserved.</p>
  </div>
</footer>
