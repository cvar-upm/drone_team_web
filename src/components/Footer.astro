---
import AssetImage from './AssetImage.astro';
import Icon from './Icon.astro';
import { navigation, joinLink } from '../data/navigation';
import { socialLinks, mapLink, address, email } from '../data/social';
import { url } from '../lib/url';
---
<footer class="border-t border-base-300 bg-base-200 text-sm">
  <div class="mx-auto grid max-w-page grid-cols-2 gap-x-6 gap-y-10 px-4 py-12 md:py-14 lg:grid-cols-4">
    <div class="col-span-2 flex flex-col gap-3 lg:col-span-1">
      <a href={url('/')} class="flex items-center gap-3">
        <AssetImage src="/logo-cvar.png" alt="" widths={[96, 192]} sizes="40px" class="h-10 w-auto" />
        <span class="text-base font-bold">CVAR-UPM Drone Team</span>
      </a>
      <p class="text-base-content/70">Computer Vision and Aerial Robotics Group, Universidad Politécnica de Madrid (UPM-CSIC).</p>
    </div>

    <nav aria-label="Footer">
      <h2 class="mb-3 font-semibold">Explore</h2>
      <ul class="flex flex-col gap-2 text-base-content/70">
        {[...navigation, joinLink].map((item) => (
          <li><a href={url(item.href)} class="hover:text-primary">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <address class="col-span-2 not-italic max-sm:order-last sm:col-span-1">
      <h2 class="mb-3 font-semibold">Visit us</h2>
      <a href={mapLink} target="_blank" rel="noopener noreferrer" class="flex flex-col gap-1 text-base-content/70 hover:text-primary">
        <span>{address.name}</span>
        {address.lines.map((line) => <span>{line}</span>)}
      </a>
      <a href={`mailto:${email}`} class="mt-3 block text-base-content/70 hover:text-primary">{email}</a>
    </address>

    <div>
      <h2 class="mb-3 font-semibold">Follow us</h2>
      <div class="-ml-2 flex flex-wrap">
        {socialLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label} class="btn btn-circle btn-ghost btn-sm text-base-content/70 hover:text-primary">
            <Icon name={link.icon} class="h-4 w-4" />
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="border-t border-base-300">
    <p class="mx-auto max-w-page px-4 py-6 text-base-content/60">&copy; {new Date().getFullYear()} CVAR-UPM Drone Team. All rights reserved.</p>
  </div>
</footer>
