---
import AssetImage from './AssetImage.astro';

interface Props {
  imageUrl: string;
  alt?: string;
}

const { imageUrl, alt = '' } = Astro.props;
---
<figure class="not-prose mx-auto my-10 max-w-5xl px-4">
  <AssetImage src={imageUrl} alt={alt} widths={[640, 1024, 1600]} sizes="(min-width: 1024px) 64rem, 100vw" class="h-auto w-full rounded-box" />
</figure>
