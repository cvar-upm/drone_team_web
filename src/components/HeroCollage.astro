---
// Four-slot photo collage. Each slot slowly crossfades through its own photos. Every photo keeps
// its own aspect ratio (no cropping or zooming of the image itself); only the card fades and drifts.
// Slots change one at a time (top-left, bottom-right, top-right, bottom-left).
// Without JS (or with "reduce motion") it shows the first photo of each slot.
import AssetImage from './AssetImage.astro';
import { resolveImage } from '../lib/images';

interface Photo {
  src: string;
  alt: string;
}

interface Props {
  /** Photos for each slot, in this order: top-left, top-right, bottom-left, bottom-right */
  slots: [Photo[], Photo[], Photo[], Photo[]];
  /** Milliseconds each photo stays in its slot */
  interval?: number;
  class?: string;
}

const { slots, interval = 8000, class: className } = Astro.props;

// Each slot: width within its column, horizontal alignment, and which edge its cards hug
// (top-row cards sit on their bottom edge and bottom-row cards on their top edge, so the gap
// between the rows stays the same whatever the photo shapes)
const slotStyle = [
  { width: 'w-full', align: 'self-start', items: 'items-end' }, // top-left
  { width: 'w-full', align: 'self-start', items: 'items-end' }, // top-right
  { width: 'w-[92%]', align: 'self-end', items: 'items-start' }, // bottom-left
  { width: 'w-[96%] xl:w-full', align: 'self-start', items: 'items-start' }, // bottom-right
];
// Position of each slot in the change sequence: top-left, then bottom-right, top-right, bottom-left
const order = [0, 2, 3, 1];
// Starting offset of the non-active photos (the script gives each change a random one)
const drifts = ['16px, 0px', '0px, 16px', '-16px, 0px', '0px, -16px'];

const ratio = (src: string) => {
  const { width, height } = resolveImage(src);
  return `${width} / ${height}`;
};

const renderSlot = (f: number) => ({ photos: slots[f], style: slotStyle[f], f });
const columns = [
  [renderSlot(0), renderSlot(2)],
  [renderSlot(1), renderSlot(3)],
];
---
<div class:list={['hero-collage grid grid-cols-[11fr_9fr] gap-x-4 sm:gap-x-6', className]} data-interval={interval}>
  {columns.map((column, c) => (
    <div class:list={['flex flex-col gap-y-6 sm:gap-y-10', c === 1 && 'pt-8 sm:pt-12']}>
      {column.map(({ photos, style, f }) => (
        <div class:list={['collage-enter', style.width, style.align]} style={`animation-delay:${150 + f * 180}ms`}>
          <div
            class:list={['collage-slot grid', style.items]}
            style={`animation-delay:-${f * 2.3}s`}
            data-offset={order[f] * (interval / 4)}
          >
            {photos.map((photo, i) => (
              <div
                class="collage-card col-start-1 row-start-1 w-full overflow-hidden rounded-box bg-base-200 shadow-xl ring-4 ring-base-100"
                style={`aspect-ratio:${ratio(photo.src)};--drift:${drifts[(f + i) % drifts.length]}`}
                data-card
                data-active={i === 0 ? '' : undefined}
                aria-hidden={i === 0 ? undefined : 'true'}
              >
                <AssetImage
                  src={photo.src}
                  alt={photo.alt}
                  widths={[400, 800, 1200]}
                  sizes="(min-width: 1024px) 32rem, 50vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  class="h-full w-full object-cover"
                />
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  ))}
</div>

<style>
  /* Photo changes: the whole card fades and drifts; the image inside is never cropped or zoomed */
  .collage-card {
    opacity: 0;
    translate: var(--drift);
    transition:
      opacity 2.5s cubic-bezier(0.45, 0, 0.55, 1),
      translate 4s cubic-bezier(0.25, 0.1, 0.25, 1);
  }
  .collage-card[data-active] {
    z-index: 1;
    opacity: 1;
    translate: 0 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* First appearance: each slot fades in and rises softly, one after another */
    .collage-enter {
      animation: collage-enter 1.6s cubic-bezier(0.22, 0.61, 0.36, 1) both;
    }
    /* Each slot floats very slowly, out of phase with the others */
    .collage-slot {
      animation: collage-float 9s ease-in-out infinite alternate;
    }
  }
  @keyframes collage-enter {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  @keyframes collage-float {
    to {
      transform: translate(2px, -4px);
    }
  }
</style>

<script>
  let timers: number[] = [];

  // Random offset (direction and distance) a photo appears from or drifts away to
  const randomDrift = () => {
    const angle = Math.random() * Math.PI * 2;
    const radius = 12 + Math.random() * 20;
    return `${Math.round(Math.cos(angle) * radius)}px ${Math.round(Math.sin(angle) * radius)}px`;
  };

  document.addEventListener('astro:page-load', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    document.querySelectorAll<HTMLElement>('.hero-collage').forEach((collage) => {
      const interval = Number(collage.dataset.interval) || 8000;

      // Load the other photos now so they are ready when their turn comes
      collage.querySelectorAll('img').forEach((img) => (img.loading = 'eager'));

      collage.querySelectorAll<HTMLElement>('.collage-slot').forEach((slot) => {
        const cards = [...slot.querySelectorAll<HTMLElement>('[data-card]')];
        if (cards.length < 2) return;
        let current = 0;

        const next = () => {
          if (document.hidden) return;
          const upcoming = (current + 1) % cards.length;
          if (!cards[upcoming].querySelector('img')?.complete) return; // not loaded yet: wait a cycle
          const leaving = cards[current];
          const arriving = cards[upcoming];

          // Outgoing photo drifts away in a random direction while it fades
          leaving.style.setProperty('--drift', randomDrift());
          leaving.removeAttribute('data-active');
          leaving.setAttribute('aria-hidden', 'true');

          // Incoming photo jumps (invisibly) to a random start offset, then settles into place
          arriving.style.transition = 'none';
          arriving.style.setProperty('--drift', randomDrift());
          void arriving.offsetWidth; // apply the start offset before turning transitions back on
          arriving.style.transition = '';
          arriving.setAttribute('data-active', '');
          arriving.removeAttribute('aria-hidden');
          current = upcoming;
        };

        // Stagger the slots so only one changes at a time
        const start = window.setTimeout(() => {
          next();
          timers.push(window.setInterval(next, interval));
        }, interval / 2 + Number(slot.dataset.offset));
        timers.push(start);
      });
    });
  });

  // Stop when navigating to another page
  document.addEventListener('astro:before-swap', () => {
    timers.forEach((id) => window.clearTimeout(id));
    timers = [];
  });
</script>
