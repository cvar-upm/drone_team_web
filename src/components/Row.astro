---
import Member from './Member.astro';

interface Props {
  members: { name: string; image?: string; github?: string; linkedin?: string }[];
}

const { members } = Astro.props;
---
<div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
  {members.map((member) => <Member {...member} />)}
</div>
