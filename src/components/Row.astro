---
import Member from './Member.astro';

interface Props {
  members: { name: string; image: string; github?: string; linkedin?: string }[];
}

const { members } = Astro.props;
---
<section class="mx-auto my-8 flex max-w-6xl flex-wrap justify-center gap-6 px-4">
  {members.map((member) => (
    <div class="w-full max-w-xs sm:w-[calc(50%-0.75rem)] lg:w-[calc(25%-1.125rem)]">
      <Member {...member} />
    </div>
  ))}
</section>
