---
import { url } from '../lib/url';

export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  intro?: string;
  breadcrumbs: Crumb[];
}

const { title, intro, breadcrumbs } = Astro.props;
---
<header class="border-b border-base-300 bg-base-200">
  <div class="mx-auto max-w-page px-4 py-8 md:py-14">
    <nav aria-label="Breadcrumb" class="breadcrumbs mb-3 p-0 text-sm text-base-content/60">
      <ul>
        {breadcrumbs.map((crumb) => (
          <li>{crumb.href ? <a href={url(crumb.href)} class="hover:text-primary">{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}</li>
        ))}
      </ul>
    </nav>
    <h1 class="text-3xl font-bold tracking-tight text-balance md:text-5xl">{title}</h1>
    {intro && <p class="mt-3 max-w-2xl text-base text-base-content/70 md:mt-4 md:text-lg">{intro}</p>}
  </div>
</header>
