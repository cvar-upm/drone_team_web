---
// Stack of images that slowly crossfade from one to the next.
// Stops for "reduce motion" users and while the tab is hidden.
import AssetImage from './AssetImage.astro';

interface Props {
  images: { src: string; alt: string; caption?: string }[];
  /** Milliseconds each image stays visible */
  interval?: number;
  /** Delay before the first change, so several slideshows don't switch at the same time */
  offset?: number;
  widths?: number[];
  sizes?: string;
  /** Load the first image eagerly (above the fold) */
  eager?: boolean;
  class?: string;
}

const { images, interval = 6000, offset = 0, widths, sizes, eager = false, class: className } = Astro.props;
---
<div class:list={['crossfade relative overflow-hidden', className]} data-interval={interval} data-offset={offset}>
  {images.map((image, i) => (
    <div
      class="absolute inset-0 opacity-0 transition-opacity duration-[1500ms] ease-in-out data-active:opacity-100"
      data-slide
      data-active={i === 0 ? '' : undefined}
      aria-hidden={i === 0 ? undefined : 'true'}
    >
      <AssetImage
        src={image.src}
        alt={image.alt}
        widths={widths}
        sizes={sizes}
        loading={eager && i === 0 ? 'eager' : 'lazy'}
        class="h-full w-full object-cover object-[center_35%]"
      />
      {image.caption && (
        <span class="absolute right-3 bottom-3 rounded-full bg-black/55 px-3 py-1 text-xs font-medium text-white backdrop-blur-sm md:right-4 md:bottom-4">
          {image.caption}
        </span>
      )}
    </div>
  ))}
</div>

<script>
  let timers: number[] = [];

  document.addEventListener('astro:page-load', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    document.querySelectorAll<HTMLElement>('.crossfade').forEach((container) => {
      const slides = [...container.querySelectorAll<HTMLElement>('[data-slide]')];
      if (slides.length < 2) return;
      const interval = Number(container.dataset.interval) || 6000;
      let current = 0;

      // Start loading the other photos now so they are ready when their turn comes
      container.querySelectorAll('img').forEach((img) => (img.loading = 'eager'));

      const next = () => {
        if (document.hidden) return;
        const upcoming = slides[(current + 1) % slides.length].querySelector('img');
        if (upcoming && !upcoming.complete) return; // not loaded yet: try again next tick
        slides[current].removeAttribute('data-active');
        slides[current].setAttribute('aria-hidden', 'true');
        current = (current + 1) % slides.length;
        slides[current].setAttribute('data-active', '');
        slides[current].removeAttribute('aria-hidden');
      };

      const start = window.setTimeout(() => {
        next();
        timers.push(window.setInterval(next, interval));
      }, interval + (Number(container.dataset.offset) || 0));
      timers.push(start);
    });
  });

  // Stop the timers when navigating to another page
  document.addEventListener('astro:before-swap', () => {
    timers.forEach((id) => window.clearTimeout(id));
    timers = [];
  });
</script>
