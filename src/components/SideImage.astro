---
import AssetImage from './AssetImage.astro';

interface Props {
  image: string;
  title: string;
  logoImage?: string;
  url?: string;
  reverse?: boolean;
}

const { image, title, logoImage, url, reverse = false } = Astro.props;
const Link = url ? 'a' : 'div';
---
<section class="mx-auto grid max-w-6xl items-center gap-8 px-4 py-10 md:grid-cols-2 md:gap-12">
  <Link href={url} class:list={['block overflow-hidden rounded-box', reverse && 'md:order-last']}>
    <AssetImage src={image} alt={title} widths={[480, 800, 1200]} sizes="(min-width: 768px) 36rem, 100vw" class="h-64 w-full object-contain md:h-96" />
  </Link>

  <div class="flex flex-col items-center gap-6 text-center">
    {logoImage && (
      <Link href={url} class="block">
        <AssetImage src={logoImage} alt="" widths={[320, 640]} sizes="20rem" class="h-auto max-h-40 w-auto max-w-full object-contain" />
      </Link>
    )}
    <h2 class="text-2xl font-bold text-balance text-primary md:text-3xl">
      {url ? <a href={url} class="hover:text-secondary">{title}</a> : title}
    </h2>
  </div>
</section>
